%option noyywrap
%{
    #include "tree_data.h"
    #include "tree.tab.h"
    #include "tree_ast.h"
    #include "tree_symtab.h"
    #include "../common/arena.h"
    #include <string.h>
    extern Arena evalArena;

%}

EXP ([eE][+-]?[0-9]+)
%s REPL

%%
";" |
":" |
"|" |
"=" |
"," |
"(" |
")" |
"[" |
"]" |
"{" |
"}" |
"+" | 
"-" | 
"*" |
"%" |
"/" {  return yytext[0]; }

">"   { return MAYOR; }
"<"   { return MENOR; }
">="  { return MAYOR_IGUAL; }
"<="  { return MENOR_IGUAL; }
"=="  { return IGUAL; }
"!="  { return DISTINTO; }

and   { return AND; }
or    { return OR; }
not   { return NOT; }

if        { return IF;      }
else      { return ELSE;    }
endif     { return ENDIF;   }
while     { return WHILE;   }
do        { return DO;      }
end       { return END;     }
forall    { return FORALL;  }
forany    { return FORANY;  }
"let"     { return LET;     }
"=>"      { return ARROW;   }

print   { return PRINT;      }
main    { return MAIN;       }
endmain { return ENDMAIN;    }
function { return FUNCTION;  }
return  { return RETURN;     }
end     { return END;        }
"$tree" { BEGIN(REPL); return PESOS_TREE; }

kick   { return KICK;   }
add    { return ADD;    }
take   { return TAKE;   }
from   { return FROM;   }
to     { return TO;     }
concat { return CONCAT; }

in        { return IN; }
union     { return UNION; }
inter     { return INTER; }
diff      { return DIFF;  }
\get       { return GET; }
\contains { return CONTAINS; }

"true" |
"false" { yylval.td = createBool(yytext); return BOOL; }

[0-9]+                  { yylval.td = createInt(atoi(strdup(yytext))); return NUM_INT; }
\"[^\"]*\"      { yylval.td = createStr(strdup(yytext)); return ATOM; }
[a-zA-Z_][a-zA-Z0-9_]*    { yylval.s = lookup(strdup(yytext)); return ID; }
[0-9]+"."?[0-9]*{EXP}? |
[0-9]*"."?[0-9]+{EXP}?  { yylval.td = createDouble(atof(strdup(yytext))); return NUM_DOUBLE; }

[ \t\r]+  {}
<REPL>\n { return EOL; }
\n  {}
"--".*     {}
.   { printf("CARACTER DESCONOCIDO: %s\n",yytext); }

%%